# Copy to .env.local and fill in. .env.local is gitignored.
#
# DATABASE_URL lives in `.env` (also gitignored) because the Prisma CLI reads
# that file. Copy .env.example to .env as well.

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public origin of the site (used for canonical URLs, sitemaps, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set in production to the public origin
# AUTH_URL="https://example.com"

# First admin account, created by `npm run db:seed` when no admin exists
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password-now"

# Image storage: "local" writes to UPLOADS_DIR and serves from /uploads.
# "s3" uploads to any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://images.example.com"

# Optional: bearer token for GET /api/cron/publish (publishes due scheduled articles)
# CRON_SECRET=""
