# Copy to .env.production for docker compose. Never commit the real file.
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://news.example.com"
NEXT_PUBLIC_SITE_URL="https://news.example.com"

# First admin, created on first boot if no admin exists
SEED_ADMIN_EMAIL="editor@example.com"
SEED_ADMIN_PASSWORD="a-long-password-at-least-12-chars"

# Images. "local" keeps files on the uploads volume. For S3-compatible storage:
STORAGE_DRIVER="local"
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://images.example.com"

# Optional bearer token for GET /api/cron/publish
# CRON_SECRET=""
